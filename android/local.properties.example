# Copy to android/local.properties (gitignored).
# GOOGLE_MAPS_API_KEY — native Google Maps tiles (Maps SDK for Android).
# When set, Gradle also sets HANDOVER_MAP_ENABLED=true for the Flutter map picker.
# Optional override: --dart-define=HANDOVER_MAP_ENABLED=false (force form fallback).
# Geocoding uses integration-service (Nominatim), not Google Geocoding.
GOOGLE_MAPS_API_KEY=